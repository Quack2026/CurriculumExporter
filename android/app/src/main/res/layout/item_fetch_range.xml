<?xml version="1.0" encoding="utf-8"?>
<!-- 范围菜单的一行：标题 + 一句说明（说明用灰色小字，免得看不懂每个选项要花多少时间）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <TextView
        android:id="@+id/rangeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mono_black"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/rangeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/mono_gray_text"
        android:textSize="@dimen/text_small" />
</LinearLayout>
