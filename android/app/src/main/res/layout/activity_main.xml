<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- 自绘顶栏：系统 ActionBar 会盖住上面的输入区，还会挡长按粘贴菜单 -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar">

        <TextView
            style="@style/TopBarTitle"
            android:layout_marginStart="@dimen/screen_pad"
            android:layout_width="match_parent"
            android:text="@string/app_name" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad">

            <!-- ===== 账号 ===== -->
            <LinearLayout
                android:id="@+id/cardInput"
                style="@style/Card">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/label_user" />

                <EditText
                    android:id="@+id/userInput"
                    style="@style/InputField"
                    android:layout_marginTop="@dimen/space_s"
                    android:hint="@string/hint_user"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/label_pass" />

                <EditText
                    android:id="@+id/passInput"
                    style="@style/InputField.Password"
                    android:layout_marginTop="@dimen/space_s"
                    android:hint="@string/hint_pass"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone" />
            </LinearLayout>

            <include
                layout="@layout/view_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />

            <TextView
                android:id="@+id/fetchBtn"
                style="@style/ButtonPrimary"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/btn_fetch" />

            <!-- 抓取中在这里扫一条细线：比系统那个转圈更贴这个界面的直线条 -->
            <com.quack.curriculumexporter.ProgressLine
                android:id="@+id/fetchProgress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/space_s"
                android:visibility="gone" />

            <!--
              获取范围做成一行能点的胶囊：单击上面的按钮会按这个范围直接开抓，
              点这一行就能改（长按「获取课表」弹的还是同一个面板）。
              原来这里只有两行灰字写着「长按可调整」，功能藏得太深了。
            -->
            <LinearLayout
                android:id="@+id/rangeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_range_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="38dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/rangeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mono_gray_text"
                    android:textSize="@dimen/text_label" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <!-- ===== 选项 ===== -->
            <LinearLayout
                android:id="@+id/cardOption"
                style="@style/Card"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/label_option" />

                <LinearLayout
                    android:id="@+id/optionRow"
                    style="@style/SettingRow.Clickable"
                    android:layout_marginTop="@dimen/space_xs">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingTitle"
                            android:text="@string/opt_military" />

                        <TextView
                            style="@style/SettingHint"
                            android:text="@string/opt_military_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/militarySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!--
              高级设置入口：做成和上面卡片同宽同风格的一行，整行可点。
              之前放在顶栏的一小行文字既不起眼、又会被系统 ActionBar 盖住，所以挪到这里。
            -->
            <LinearLayout
                android:id="@+id/settingsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <TextView
                    style="@style/SettingTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_entry" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_note"
                android:textColor="@color/mono_gray_hint"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/mono_gray_hint"
                android:textSize="@dimen/text_label" />

            <!-- ===== 日志 ===== -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/label_log" />

            <TextView
                android:id="@+id/logView"
                style="@style/LogText"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:text="@string/log_idle" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
