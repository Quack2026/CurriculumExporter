<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_white"
    android:orientation="vertical">

    <!-- 自绘顶栏：系统 ActionBar 会盖住上面的输入区，还会挡长按粘贴菜单 -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar">

        <TextView
            style="@style/TopBarTitle"
            android:layout_marginStart="@dimen/screen_pad"
            android:layout_width="match_parent"
            android:text="@string/app_name" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad">

            <!-- ===== 账号 ===== -->
            <LinearLayout
                android:id="@+id/cardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/label_user" />

                <EditText
                    android:id="@+id/userInput"
                    style="@style/InputField"
                    android:layout_marginTop="@dimen/space_s"
                    android:hint="@string/hint_user"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/label_pass" />

                <EditText
                    android:id="@+id/passInput"
                    style="@style/InputField.Password"
                    android:layout_marginTop="@dimen/space_s"
                    android:hint="@string/hint_pass"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone" />
            </LinearLayout>

            <include
                layout="@layout/view_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />

            <Button
                android:id="@+id/fetchBtn"
                style="@style/ButtonPrimary"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/btn_fetch" />

            <!-- ===== 选项 ===== -->
            <LinearLayout
                android:id="@+id/cardOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/label_option" />

                <LinearLayout
                    style="@style/SettingRow"
                    android:layout_marginTop="@dimen/space_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/opt_military"
                            android:textColor="@color/mono_black"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/opt_military_hint"
                            android:textColor="@color/mono_gray_text"
                            android:textSize="@dimen/text_label" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/militarySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!--
              高级设置入口：做成和上面卡片同宽同风格的一行，整行可点。
              之前放在顶栏的一小行文字既不起眼、又会被系统 ActionBar 盖住，所以挪到这里。
            -->
            <LinearLayout
                android:id="@+id/settingsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_entry"
                    android:textColor="@color/mono_black"
                    android:textSize="@dimen/text_body" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:lineSpacingExtra="2dp"
                android:text="@string/privacy_note"
                android:textColor="@color/mono_gray_hint"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/mono_gray_hint"
                android:textSize="@dimen/text_label" />

            <!-- ===== 日志 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/label_log" />

                <ProgressBar
                    android:id="@+id/busyBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="@dimen/space_s"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/logView"
                style="@style/LogText"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:text="@string/log_idle"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
