<?xml version="1.0" encoding="utf-8"?>
<!--
  分段控件那块滑块。加一圈描边是为了暗色模式：暗色下轨道和滑块都是深灰，
  只靠明度差在部分屏幕上几乎看不出滑块停在哪，「选中了哪一边」这个信息就丢了。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/segment_thumb" />
    <corners android:radius="@dimen/radius_s" />
    <stroke
        android:width="1dp"
        android:color="@color/segment_thumb_line" />
</shape>
