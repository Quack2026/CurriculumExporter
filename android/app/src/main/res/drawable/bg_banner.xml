<?xml version="1.0" encoding="utf-8"?>
<!-- 提示条：圆角卡片 + 左侧一条强调色，用来和普通卡片区分开 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke
                android:width="1dp"
                android:color="@color/card_line" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorAccent" />
            <corners
                android:bottomLeftRadius="@dimen/radius_m"
                android:topLeftRadius="@dimen/radius_m" />
        </shape>
    </item>
</layer-list>
