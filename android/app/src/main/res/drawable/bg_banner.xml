<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mono_surface" />
            <corners android:radius="@dimen/radius_s" />
        </shape>
    </item>
    <!-- 左侧 4dp 黑条：黑白界面上用来区分「提示条」和普通卡片 -->
    <item
        android:width="4dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/mono_black" />
            <corners
                android:bottomLeftRadius="@dimen/radius_s"
                android:topLeftRadius="@dimen/radius_s" />
        </shape>
    </item>
</layer-list>
