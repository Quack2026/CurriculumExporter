<?xml version="1.0" encoding="utf-8"?>
<!--
  自绘对话框：没有用 AlertDialog 的标题/正文/按钮位，标题正文按钮都是自己的 View，
  所以圆角、间距、按钮形态都跟着 design token 走，不受平台主题影响。

  最外层是 FrameLayout：遮罩（scrim）和卡片都在这里，窗口本身透明、无 dim。
  这样「背景变暗」和「卡片弹出来」是同一段动画，而不是系统先瞬间变暗、内容再出现。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dialogScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="@dimen/dialog_pad">

        <TextView
            android:id="@+id/dialogTitle"
            style="@style/DialogTitle"
            tools:text="确认写入日历？" />

        <TextView
            android:id="@+id/dialogMessage"
            style="@style/DialogMessage"
            android:visibility="gone"
            tools:text="会把 32 个事件写进「我的课表」。"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/dialogBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/dialogButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogNegative"
                style="@style/ButtonSecondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                tools:text="取消" />

            <TextView
                android:id="@+id/dialogPositive"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_s"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                tools:text="确定" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
