<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar">

        <ImageView
            android:id="@+id/backBtn"
            style="@style/TopBarButton"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TopBarTitle"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad">

            <!-- ===== 课表日历 ===== -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/settings_calendar_section" />

                <EditText
                    android:id="@+id/calendarNameInput"
                    style="@style/InputField"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/settings_calendar_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/settings_calendar_name_note"
                    android:textColor="@color/mono_gray_text"
                    android:textSize="@dimen/text_label" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@color/mono_divider" />

                <!-- 每一行整行可点：点文字也能切换，不用非得戳中右边的开关 -->
                <LinearLayout
                    android:id="@+id/calendarPickerRow"
                    style="@style/SettingRow.Clickable">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingTitle"
                            android:text="@string/settings_use_picker" />

                        <TextView
                            style="@style/SettingHint"
                            android:text="@string/settings_use_picker_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/usePickerSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/mono_divider" />

                <LinearLayout
                    android:id="@+id/showAllRow"
                    style="@style/SettingRow.Clickable">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingTitle"
                            android:text="@string/settings_show_all" />

                        <TextView
                            style="@style/SettingHint"
                            android:text="@string/settings_show_all_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/showAllSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 写入确认 ===== -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/settings_confirm_section" />

                <LinearLayout
                    android:id="@+id/confirmWriteRow"
                    style="@style/SettingRow.Clickable">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_confirm_write" />

                    <Switch
                        android:id="@+id/confirmWriteSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/mono_divider" />

                <LinearLayout
                    android:id="@+id/confirmReplaceRow"
                    style="@style/SettingRow.Clickable">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_confirm_replace" />

                    <Switch
                        android:id="@+id/confirmReplaceSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 账户 ===== -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/settings_account_section" />

                <LinearLayout
                    android:id="@+id/savePasswordRow"
                    style="@style/SettingRow.Clickable">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingTitle"
                            android:text="@string/settings_save_password" />

                        <TextView
                            style="@style/SettingHint"
                            android:text="@string/settings_save_password_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/savePasswordSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 外观 ===== -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/settings_theme_section" />

                <LinearLayout
                    android:id="@+id/dynamicThemeRow"
                    style="@style/SettingRow.Clickable">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingTitle"
                            android:text="@string/settings_dynamic_theme" />

                        <TextView
                            style="@style/SettingHint"
                            android:text="@string/settings_dynamic_theme_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/dynamicThemeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/saveSettingsBtn"
                style="@style/ButtonPrimary"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
