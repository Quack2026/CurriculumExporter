<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      暗色系统对话框也使用暗色父主题，避免权限/选择日历弹窗仍是亮白色。
      结构说明同 values/themes.xml：*Base 才是完整定义，AppTheme/AppThemePlain 只负责派生。
    -->
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorButtonNormal">@color/app_surface</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/topbar</item>
        <!-- 暗色下顶栏/状态栏也是深色，所以系统图标要用浅色（Light 标记反而是给浅底用的） -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase" />

    <style name="AppThemePlainBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorPrimary">@color/plain_accent</item>
        <item name="android:colorPrimaryDark">@color/plain_accent</item>
        <item name="android:colorAccent">@color/plain_accent</item>
        <item name="android:colorControlActivated">@color/plain_accent</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/topbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppThemePlain" parent="AppThemePlainBase" />

    <!-- 同 values/themes.xml，只是换成暗色平台的对话框父主题。 -->
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
